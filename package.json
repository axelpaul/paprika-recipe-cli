{
  "name": "paprika-recipe-cli",
  "version": "0.1.0",
  "description": "Unofficial Paprika Recipe Manager CLI with safe recipe sync and photo upload",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/axelpaul/paprika-recipe-cli"
  },
  "bugs": {
    "url": "https://github.com/axelpaul/paprika-recipe-cli/issues"
  },
  "homepage": "https://github.com/axelpaul/paprika-recipe-cli#readme",
  "keywords": [
    "paprika",
    "recipe",
    "cli",
    "cooking",
    "meal-planning",
    "grocery",
    "unofficial"
  ],
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "paprika": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@bojanrajkovic/mcp-paprika": "^1.6.0",
    "commander": "^13.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.0"
  }
}
